# Copy this file to ".env" and fill it in (for running on your own computer).
# On a hosting site (Render etc.) add these as "Environment Variables" instead.

ELEVENLABS_API_KEY=paste_your_key_here

# Password people must type to use the tool. Give it only to testers.
ACCESS_CODE=choose-a-code

# Cost protection
MAX_CHARS_PER_REQUEST=3000
DAILY_CHAR_LIMIT=50000

# Voice model. If v4 gives an error, try eleven_v3
ELEVEN_MODEL=eleven_v4

# Accounts (Supabase). Both values are public, safe to keep in the page.
SUPABASE_URL=https://ijcquxwmhnqujxfingko.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_LxDgO9NoeUv1abliAcWGQw_p1Vp9hwb

# Payments (Stripe). Leave these out and the Subscribe button says "opening soon".
# Secret values: put them ONLY in Render's Environment Variables. Never in GitHub, never in chat.
STRIPE_SECRET_KEY=sk_test_or_sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_SECRET_KEY=sb_secret_...
SITE_URL=https://suvoz.io

# Emails sent by the server (sales form, receipts, cancel confirmations). Without RESEND_API_KEY the server just skips them.
RESEND_API_KEY=
MAIL_FROM=Suvoz <support@suvoz.io>
SALES_TO=sales@suvoz.io
# Where feedback messages from the "Send feedback" page are emailed (defaults to SALES_TO).
FEEDBACK_TO=

# Links shown in the profile menu. Leave empty to hide an item.
DISCORD_URL=
INSTAGRAM_URL=
TIKTOK_URL=
AFFILIATE_URL=
