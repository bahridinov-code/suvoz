# Copy this file to ".env" and fill it in (for running on your own computer).
# On a hosting site (Render etc.) add these as "Environment Variables" instead.

ELEVENLABS_API_KEY=paste_your_key_here

# Password people must type to use the tool. Give it only to testers.
ACCESS_CODE=choose-a-code

# Cost protection
MAX_CHARS_PER_REQUEST=3000
DAILY_CHAR_LIMIT=50000

# Voice model. If v4 gives an error, try eleven_v3
ELEVEN_MODEL=eleven_v4

